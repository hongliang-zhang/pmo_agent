GITLAB_BASE_URL=https://dev.aminer.cn
GITLAB_GROUP=open-platform
GITLAB_TOKEN=

FEISHU_PROJECT_MCP_URL=https://project.feishu.cn/mcp_server/v1
# Optional alternatives when OAuth is not available:
FEISHU_PROJECT_MCP_TOKEN=
FEISHU_PROJECT_MCP_BEARER_TOKEN=
FEISHU_PROJECT_MCP_AUTH_HEADER=
FEISHU_PROJECT_SPACE_NAME=MAAS_平台
FEISHU_PROJECT_SPACE_URL=https://project.feishu.cn/7358164361912909827_1719375156/story/homepage
FEISHU_PROJECT_ACTIVE_STATUSES=开发阶段,测试阶段,上线阶段,进行中

# Optional lark-mcp launch override. Defaults to ~/.codex/config.toml.
LARK_MCP_COMMAND=
LARK_MCP_ARGS=
PMO_LARK_MCP_TIMEOUT_MS=30000

PMO_TIMEZONE=Asia/Shanghai
PMO_REPORTS_DIR=reports
PMO_SERVE_REPORTS=false
# Optional Basic Auth for everything except GET /health. Format: username:password.
PMO_HTTP_BASIC_AUTH=
PMO_PUBLIC_BASE_URL=https://pmo.hongliang.app
PMO_OPENAI_API_KEY=
WEBUI_ADMIN_EMAIL=
WEBUI_ADMIN_PASSWORD=

# Feishu bot event endpoint: POST ${PMO_PUBLIC_BASE_URL}/feishu/events.
# Set the same Verification Token in Feishu Open Platform event subscription.
PMO_FEISHU_EVENT_VERIFICATION_TOKEN=
# Keep encrypted event delivery disabled for Phase 1 bot. Signature verification can
# use this key when Feishu sends X-Lark-Signature headers, but encrypted payload
# decryption is intentionally not enabled yet.
PMO_FEISHU_EVENT_ENCRYPT_KEY=
PMO_FEISHU_BOT_ALLOWED_USER_IDS=
PMO_FEISHU_BOT_ALLOWED_OPEN_IDS=
PMO_FEISHU_BOT_ALLOWED_UNION_IDS=
PMO_FEISHU_BOT_ALLOWED_CHAT_IDS=
PMO_FEISHU_BOT_OPEN_ID=
PMO_FEISHU_BOT_USER_ID=
PMO_FEISHU_BOT_DENY_REPLY=false

# Phase 3 model policy. Keep the actual key in .env.local only.
ZAI_API_KEY=
ZAI_ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ZAI_OPENAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
PMO_DAILY_MODEL=glm-5-turbo
PMO_RISK_MODEL=glm-5.1

# Phase 3 Feishu IM delivery guard. Keep false unless Feishu IM send permission,
# recipient open_id mapping, and the delivery adapter are verified.
PMO_FEISHU_IM_DELIVERY_ENABLED=false
FEISHU_OPENAPI_BASE_URL=https://open.feishu.cn/open-apis
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TENANT_ACCESS_TOKEN=

# Feishu document output. Prefer OpenAPI when FEISHU_APP_ID/FEISHU_APP_SECRET
# are configured; lark-mcp remains available as a legacy fallback.
PMO_FEISHU_DOC_OUTPUT_MODE=openapi
PMO_FEISHU_DOC_TITLE=MAAS_平台 PMO 状态核查日报
PMO_FEISHU_DOC_FOLDER_TOKEN=
PMO_FEISHU_DOC_WEB_BASE_URL=https://zhipu-ai.feishu.cn/docx

# Feishu Project field mapping for approved writeback actions.
# Live-discovered MAAS_平台 field keys; NEXT_STEP has no clear field yet.
PMO_FEISHU_FIELD_GOAL=description
PMO_FEISHU_FIELD_TEST_PLAN=field_7f3085
PMO_FEISHU_FIELD_NEXT_STEP=
PMO_FEISHU_FIELD_DUE_DATE=field_810cee
PMO_FEISHU_FIELD_STATUS=work_item_status

# Production worker defaults.
PMO_DAILY_RUN_AT=09:00
PMO_WORKER_TICK_MS=300000
PMO_WORKER_CREATE_FEISHU_DOC=false
PMO_WORKER_CREATE_REPORT_DM_DRAFT=false
PMO_WORKER_BUILD_PERSON_DIRECTORY=true
PMO_WORKER_ANALYZE_WITH_MODELS=false
PMO_WORKER_ENRICH_CONTEXT=true
PMO_WORKER_MAX_PROJECTS=
PMO_WORKER_SKIP_PREFLIGHT=false
PMO_TENCENT_CLOUD_DEPLOYED=false

# Optional daily report recipient. User ID is supported for 张鸿亮's provided uid.
PMO_DAILY_REPORT_RECIPIENT_NAME=张鸿亮
PMO_DAILY_REPORT_RECIPIENT_USER_ID=test-user-id
PMO_DAILY_REPORT_RECIPIENT_OPEN_ID=
PMO_DAILY_REPORT_RECIPIENT_CHAT_ID=
PMO_DAILY_REPORT_RECIPIENT_EMAIL=
